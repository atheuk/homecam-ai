APP_ENV=development
DATABASE_URL=postgresql+asyncpg://homecam:homecam@postgres:5432/homecam
REDIS_URL=redis://redis:6379/0
SECRET_KEY=change-me-in-development
AI_PROVIDER=mock
MEDIAMTX_URL=http://media:8889
LOW_BATTERY_THRESHOLD=20
SESSION_TTL_MINUTES=720

# Dahua NVR integration (opt-in). Keep QR-derived credentials in your local
# .env only; never commit them. The label serial for the target NVR is
# 5J006FCPAZ6B52A, but the LAN host and local username/password must be set
# by the owner.
DAHUA_ENABLED=false
DAHUA_SCHEME=http
DAHUA_HOST=
DAHUA_PORT=80
DAHUA_USERNAME=
DAHUA_PASSWORD=
DAHUA_SERIAL=5J006FCPAZ6B52A
# Comma-separated NVR channel map: channel[:name[:camera|doorbell]]
DAHUA_CHANNELS=1:Front Door,2:Driveway,3:Backyard,4:Garden
DAHUA_TIMEOUT_SECONDS=5
DAHUA_RETRIES=1

# Eufy integration boundary (opt-in). Run a local edge adapter/bridge that
# owns Eufy login, 2FA/captcha, session persistence, and SDK protocol details.
# Do not store Eufy account credentials in this repository.
EUFY_ENABLED=false
EUFY_ADAPTER_URL=
EUFY_ADAPTER_TOKEN=
EUFY_TIMEOUT_SECONDS=10
EUFY_RETRIES=1
