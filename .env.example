APP_ENV=development
DATABASE_URL=postgresql+asyncpg://homecam:homecam@postgres:5432/homecam
REDIS_URL=redis://redis:6379/0
SECRET_KEY=change-me-in-development
AI_PROVIDER=mock
MEDIAMTX_URL=http://media:8889
LOW_BATTERY_THRESHOLD=20
SESSION_TTL_MINUTES=720

# AI event-analysis pipeline (see docs/ai-pipeline.md). Defaults need no
# extra dependencies: the mock detector and mock AI provider are fully
# deterministic and run offline.
AI_ANALYSIS_ENABLED=true
# mock | rtdetr | opencv | onnx.
#   mock   - default. Zero dependencies, used by CI and every test. It
#            CANNOT see pixels: a bare motion trigger yields no detections,
#            so with real cameras you get no real object detection at all.
#   rtdetr - recommended, and what production on Azure runs. Apache-2.0
#            RT-DETR weights are downloaded and baked into the image at
#            build time by apps/api/Dockerfile (/app/models/rtdetr.onnx), so
#            a running container never needs huggingface.co. Use it with
#            AI_DETECTOR_MODEL_PATH=/app/models/rtdetr.onnx (or leave empty
#            for that default). See docker-compose.local.yml / README.md.
#   opencv - legacy HOG detector; produces phantom "person" boxes on empty
#            frames. Do not use.
#   onnx   - legacy YOLO path; bring your own (licensed) model.
# Any backend that fails to load logs a warning and falls back to mock.
AI_DETECTOR_BACKEND=mock
AI_DETECTOR_MODEL_PATH=
# Background loop that snapshots every online camera and creates real events
# from detections. Off by default; only useful with a pixel-aware backend.
EVENT_INGESTION_ENABLED=false
# Optional Azure AI Foundry account for person identity only (appearance
# captions, coarse apparent age band, clothing/carried items, face-visible,
# automatic re-identification of returning visitors). Gender and ethnicity
# are deliberately never inferred (see app/ai/appearance.py). Trust status
# is only ever set by a person via the API, never inferred, and needs no
# Foundry. Object detection is fully local and offline; leave these empty
# and identity features simply switch off.
FOUNDRY_ENDPOINT=
FOUNDRY_API_KEY=
EMBEDDING_DIMENSIONS=384
MEDIA_ROOT=./media
BEST_PHOTO_ENABLED=true
BEST_PHOTO_FRAMES=3
BEST_PHOTO_MIN_CROP_PIXELS=720
BEST_PHOTO_JPEG_QUALITY=94
BEST_PHOTO_SNAPSHOT_TIMEOUT_SECONDS=4
ZONE_MIN_OVERLAP=0.3
PARKED_VEHICLE_SECONDS=60
# Speech-like audio *activity* detection only: never transcription or
# speaker identification. No provider exposes an audio buffer yet.
AUDIO_DETECTION_ENABLED=false
AUDIO_ENERGY_THRESHOLD=0.02
ACTIVITY_CORRELATION_ENABLED=true
ACTIVITY_CORRELATION_WINDOW_SECONDS=120

# Dahua NVR integration (opt-in). These env vars are only an optional local
# seed/default used when no Dahua config is enabled via the admin API/UI
# (Settings tab -> Admin panel, or POST /api/v1/admin/providers/dahua). Once
# a Dahua config is created and enabled there, it takes precedence over
# these values and can be changed at runtime without restarting the process.
# Keep QR-derived credentials in your local .env only; never commit them.
# The label serial for the target NVR is 5J006FCPAZ6B52A, but the LAN host
# and local username/password must be set by the owner (via env seed or the
# admin UI/API) — HomeCam never guesses or fabricates a Dahua LAN IP.
DAHUA_ENABLED=false
DAHUA_SCHEME=http
DAHUA_HOST=
DAHUA_PORT=80
DAHUA_USERNAME=
DAHUA_PASSWORD=
DAHUA_SERIAL=5J006FCPAZ6B52A
# Comma-separated NVR channel map: channel[:name[:camera|doorbell]]
DAHUA_CHANNELS=1:Front Door,2:Driveway,3:Backyard,4:Garden
DAHUA_TIMEOUT_SECONDS=5
DAHUA_EVIDENCE_SNAPSHOT_TIMEOUT_SECONDS=3
DAHUA_RETRIES=1

# Optional edge mode: instead of Azure reaching the Dahua NVR directly,
# it can call a small "edge connector" you run on your Home Assistant /
# Raspberry Pi host (see apps/edge/), reached over a private overlay
# network (Tailscale recommended). See docs/edge-connector.md. Prefer
# configuring this at runtime via the admin API/UI instead of here, so
# the edge endpoint/token can be changed without a redeploy.
DAHUA_MODE=direct
DAHUA_EDGE_URL=
DAHUA_EDGE_TOKEN=
DAHUA_EDGE_TIMEOUT_SECONDS=5
DAHUA_EDGE_RETRIES=1

# Eufy integration boundary (opt-in). These env vars are only an optional
# local seed/default used when no Eufy config is enabled via the admin
# API/UI (Settings tab -> Admin panel, or POST /api/v1/admin/providers/eufy).
# Once a Eufy config is created and enabled there, it takes precedence over
# these values and can be changed at runtime without restarting the process.
# Run a local edge adapter/bridge that owns Eufy login, 2FA/captcha, session
# persistence, and SDK protocol details. Do not store Eufy account
# credentials in this repository.
EUFY_ENABLED=false
EUFY_ADAPTER_URL=
EUFY_ADAPTER_TOKEN=
EUFY_TIMEOUT_SECONDS=10
EUFY_RETRIES=1
