# HomeCam Eufy edge adapter - Home Assistant host env vars.
# Copy to .env next to docker-compose.yml and fill in your real values.
# Never commit a filled-in .env file.
#
# NOTE: there are no Eufy account credentials here, by design. Your Eufy
# email/password, 2FA and captcha state live in the eufy-security-ws
# bridge only. This adapter -- and HomeCam in Azure -- never see them.

# --- The eufy-security-ws bridge on this host ---
EUFY_WS_URL=ws://127.0.0.1:3000

# --- This adapter's own auth (what HomeCam sends as a bearer token) ---
# Generate with: openssl rand -hex 32
# Paste the same value into HomeCam's Admin -> Settings -> Eufy adapter token.
HOME_CAM_EUFY_TOKEN=change-me

# --- go2rtc (bundled with Frigate, or the standalone add-on) ---
# Internal address this adapter uses to register the stream.
GO2RTC_URL=http://127.0.0.1:1984
# Address Azure/the browser should fetch HLS from. Point this at this
# host's Tailscale IP/MagicDNS name, e.g.
# http://homeassistant.your-tailnet.ts.net:1984
GO2RTC_PUBLIC_URL=http://127.0.0.1:1984

# How go2rtc's ffmpeg reaches this adapter to pull the raw H.264 feed.
# Must be resolvable from inside the go2rtc/Frigate container.
SELF_URL=http://127.0.0.1:8091

# Single-purpose token guarding the internal raw-H.264 endpoint. Generated
# per process start if unset; set it explicitly if go2rtc and this adapter
# restart independently.
STREAM_TOKEN=

PORT=8091
