# HomeCam edge connector - Raspberry Pi / Home Assistant host env vars.
# Copy to .env next to docker-compose.yml and fill in your real values.
# Never commit a filled-in .env file.

# --- Dahua NVR (LAN-only; stays on this host, never sent to Azure) ---
DAHUA_SCHEME=http
DAHUA_HOST=192.168.1.50
DAHUA_PORT=80
DAHUA_USERNAME=admin
DAHUA_PASSWORD=change-me
# Comma-separated "channel:name[:type]" entries, type is camera|doorbell.
DAHUA_CHANNELS=1:Front Door,2:Driveway

# --- This connector's own auth (unrelated to the Dahua credentials) ---
# Generate with: openssl rand -hex 32
HOME_CAM_EDGE_TOKEN=change-me-too

# --- Browser-safe stream relay (MediaMTX) ---
# Base URL Azure/the browser should use for HLS playback. Point this at
# this host's Tailscale IP/MagicDNS name and the MediaMTX HLS port, e.g.
# http://raspberrypi.your-tailnet.ts.net:8888
STREAM_BASE_URL=http://127.0.0.1:8888
DAHUA_EVIDENCE_SNAPSHOT_TIMEOUT_SECONDS=3

# Which Dahua stream MediaMTX pulls: 1 = substream, 0 = mainstream.
# Keep this at 1. MediaMTX does not transcode, and the mainstream is
# typically 4K H.265/HEVC, which browsers cannot decode via hls.js/Media
# Source Extensions -- live view then fails or stutters regardless of how
# good the network is. The substream is H.264 and plays everywhere.
# Requires the substream to be enabled per-channel and set to H.264 in
# the NVR's own encode settings; otherwise those RTSP sessions time out.
DAHUA_STREAM_SUBTYPE=1
